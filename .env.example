# Copy to .env and fill in. The tomato course runs without these keys.
# Speech and freer wording of answers use Gemini when a key is present.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Local development uses data/store.json.
# Set DATABASE_URL when PostgreSQL with pgvector is running (see docker-compose.yml).
DATABASE_URL=postgresql://menyamuhinzi:menyamuhinzi@localhost:5432/menyamuhinzi
REDIS_URL=redis://localhost:6379

API_PORT=4000
AI_PORT=8000
AI_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
WEB_ORIGIN=http://localhost:3000
